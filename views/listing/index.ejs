<% layout('/layouts/boilerplate') %>
<div class="filters row-cols-12">
    <a class="icons" href="/listing?category=Trending"><div class="filter col">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div></a>
    <a class="icons" href="/listing?category=Rooms"><div class="filter col">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div></a>
    <a class="icons" href="/listing?category=Iconic Cities"><div class="filter col">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
    </div></a>
    <a class="icons" href="/listing?category=Mountains"><div class="filter col d-none d-sm-block">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </div></a>
    <a class="icons" href="/listing?category=Castles"><div class="filter col d-none d-sm-block">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </div></a>
    <a class="icons" href="/listing?category=Amazing pools"><div class="filter col d-none d-md-block">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing pools</p>
    </div></a>
    <a class="icons" href="/listing?category=Camping"><div class="filter col d-none d-md-block">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </div></a>
    <a class="icons" href="/listing?category=Farms"><div class="filter col d-none d-lg-block">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
    </div></a>
    <a class="icons" href="/listing?category=Cities"><div class="filter col d-none d-lg-block">
        <div><i class="fa-solid fa-city"></i></div>
        <p>Cities</p>
    </div></a>
    <a class="icons" href="/listing?category=Nature"><div class="filter col d-none d-xl-block">
        <div><i class="fa-solid fa-leaf"></i></div>
        <p>Nature</p>
    </div></a>
    <a class="icons" href="/listing?category=Boats"><div class="filter col d-none d-xl-block">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
    </div></a>
    <a class="icons" href="/listing?category=Arctic"><div class="filter col d-none d-xl-block">
        <div><i class="fa-regular fa-snowflake"></i></div>
        <p>Arctic</p>
    </div></a>
    <div class="tax-switch d-none d-xxl-block">
        <div class="form-check form-switch form-check-reverse">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
    </div>
</div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% if(allListings.length == 0) {%>
            <h2 class="message">No Listings Found !</h2>
        <% }  else {%>
            <% for(let listing of allListings){ %>
        <a href="/listing/<%=listing._id%>" class="listing-link">
            <div class="card listing-card col">
            <img src="<%=listing.image.url%>" class="card-img-top" alt="listing image" style="height:20rem;">
            <div class="card-img-overlay"></div>
                <div class="card-body">
                    <b><p class="card-text"><%= listing.title %> </b><br>
                        &#8377;<%= listing.price.toLocaleString("en-In") %> / night
                        <i class="tax-info">&nbsp; +18% GST</i>
                    </p>
                </div>
            </div>
        </a>
        <% }
    } %>
    </div>